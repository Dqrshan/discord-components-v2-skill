---
const repo = 'https://github.com/Dqrshan/discord-components-v2-skill';
---

<section class="section compare" id="compare" aria-labelledby="compare-title">
  <div class="container">
    <div class="compare__head" data-reveal>
      <h2 id="compare-title">Same words. Different message.</h2>
      <p>
        Embeds squeeze everything into one block. Containers give each part its own place, with real buttons
        and room to breathe.
      </p>
    </div>

    <div class="compare__grid">
      <figure class="panel" data-reveal style="--i: 1">
        <figcaption class="panel__caption">
          <span class="panel__name">Embed</span>
          <span class="panel__api">content + embeds</span>
        </figcaption>
        <div class="panel__frame">
          <div class="msg">
            <div class="msg__avatar" aria-hidden="true">N</div>
            <div class="msg__body">
              <div class="msg__head">
                <span class="msg__name">Nova</span>
                <span class="msg__bot">bot</span>
                <span class="msg__time">Today at 4:20 PM</span>
              </div>
              <div class="embed">
                <div class="embed__title">Server Rules</div>
                <div class="embed__text">Please read carefully.</div>
                <div class="embed__fields">
                  <div><strong>1.</strong> Be respectful</div>
                  <div><strong>2.</strong> No spam</div>
                  <div><strong>3.</strong> Follow the ToS</div>
                </div>
                <div class="embed__footer">Updated 2026</div>
              </div>
              <div class="actions">
                <span class="action action--secondary">I Agree</span>
              </div>
            </div>
          </div>
        </div>
        <p class="panel__note">Fixed chrome, cramped type, and a footer competing with the content.</p>
      </figure>

      <figure class="panel panel--v2" data-reveal data-glow style="--i: 2">
        <figcaption class="panel__caption">
          <span class="panel__name">Container</span>
          <span class="panel__api">flags: IsComponentsV2</span>
        </figcaption>
        <div class="panel__frame">
          <div class="msg">
            <div class="msg__avatar" aria-hidden="true">N</div>
            <div class="msg__body">
              <div class="msg__head">
                <span class="msg__name">Nova</span>
                <span class="msg__bot">bot</span>
                <span class="msg__time">Today at 4:20 PM</span>
              </div>
              <div class="card">
                <div class="card__title">Server Rules</div>
                <div class="card__text" style="margin-top: 3px">Please read carefully.</div>
                <div class="divider"></div>
                <div class="rows">
                  <div class="row"><span class="row__num">1.</span><span>Be respectful to everyone</span></div>
                  <div class="row"><span class="row__num">2.</span><span>No spam or self-promotion</span></div>
                  <div class="row"><span class="row__num">3.</span><span>Follow the Discord Terms of Service</span></div>
                </div>
                <div class="actions"><span class="action action--ok">I Agree</span></div>
              </div>
            </div>
          </div>
        </div>
        <p class="panel__note">Readable hierarchy, real sections, and a button that belongs to the message.</p>
      </figure>
    </div>

    <p class="compare__foot" data-reveal>
      Containers, sections, separators, galleries, and selects.
      <a class="text-link" href={repo}>Read the skill</a>
    </p>
  </div>
</section>

<style>
  .compare {
    padding-block: clamp(64px, 8vw, 104px) clamp(72px, 9vw, 112px);
  }

  .compare__head {
    max-width: 620px;
    margin-inline: auto;
    text-align: center;
    display: grid;
    gap: 14px;
  }

  .compare__head h2 {
    font-size: clamp(1.9rem, 3.4vw, 2.9rem);
  }

  .compare__head p {
    color: var(--muted);
    font-size: 1.0625rem;
    max-width: 48ch;
    margin-inline: auto;
  }

  .compare__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    margin-top: 52px;
  }

  .panel {
    margin: 0;
    display: grid;
    gap: 12px;
    align-content: start;
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: var(--r-panel);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.018), transparent), var(--bg-2);
  }

  .panel--v2 {
    border-color: rgba(88, 101, 242, 0.32);
    background:
      radial-gradient(
        380px circle at var(--px, 50%) var(--py, 0%),
        rgba(88, 101, 242, 0.16),
        transparent 60%
      ),
      linear-gradient(180deg, rgba(88, 101, 242, 0.06), transparent 44%),
      var(--bg-2);
  }

  .panel__caption {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    font-size: 0.8125rem;
  }

  .panel__name {
    font-weight: 600;
    color: var(--text);
  }

  .panel__api {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--dim);
  }

  .panel__frame {
    border: 1px solid var(--line);
    border-radius: var(--r-media);
    background: var(--surface);
    padding: 18px;
    min-height: 250px;
  }

  .panel--v2 .panel__frame {
    background: #191d25;
  }

  .panel__note {
    font-size: 0.8125rem;
    line-height: 1.55;
    color: var(--dim);
    max-width: 44ch;
  }

  .compare__foot {
    margin-top: 34px;
    text-align: center;
    font-size: 0.875rem;
    color: var(--muted);
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 8px;
  }

  .text-link {
    color: var(--accent-bright);
    text-decoration: underline;
    text-decoration-color: rgba(124, 134, 255, 0.4);
    text-underline-offset: 3px;
    transition: text-decoration-color 0.18s var(--ease);
  }

  .text-link:hover {
    text-decoration-color: var(--accent-bright);
  }

  .embed {
    background: #20242c;
    border-left: 3px solid var(--accent);
    border-radius: 4px;
    padding: 10px 12px;
    max-width: 100%;
  }

  .embed__title {
    font-size: 14px;
    font-weight: 650;
    color: #f7f8fb;
    line-height: 1.3;
  }

  .embed__text {
    font-size: 12px;
    line-height: 1.4;
    color: #c8ccd5;
    margin-top: 2px;
  }

  .embed__fields {
    display: grid;
    gap: 3px;
    margin-top: 8px;
    font-size: 11.5px;
    color: #c8ccd5;
  }

  .embed__fields strong {
    color: #eef0f6;
    font-weight: 600;
  }

  .embed__footer {
    margin-top: 9px;
    font-size: 10.5px;
    color: #8f97a6;
  }

  @media (max-width: 860px) {
    .compare__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 26px;
      margin-top: 40px;
    }

    .panel__frame {
      min-height: 0;
    }
  }
</style>
