---
const repo = 'https://github.com/Dqrshan/discord-components-v2-skill';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__brand">
      <span class="footer__mark" aria-hidden="true"><span></span><span></span></span>
      <span>Components V2</span>
    </div>

    <nav class="footer__links" aria-label="Project links">
      <a href={repo}>GitHub</a>
      <a href={`${repo}/blob/main/SKILL.md`}>SKILL.md</a>
      <a href={`${repo}#readme`}>README</a>
      <a href={`${repo}/blob/main/LICENSE`}>MIT license</a>
    </nav>

    <p class="footer__legal">
      {year} Darshan. An unofficial skill for discord.js, not affiliated with Discord Inc.
    </p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    padding-block: 34px 40px;
  }

  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 18px 28px;
  }

  .footer__brand {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .footer__mark {
    display: grid;
    gap: 2.5px;
    padding: 5.5px;
    border-radius: 7px;
    background: var(--accent);
  }

  .footer__mark span {
    display: block;
    width: 11px;
    height: 3px;
    border-radius: 2px;
    background: #fff;
  }

  .footer__mark span:last-child {
    width: 6px;
    opacity: 0.6;
  }

  .footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 22px;
    margin-left: auto;
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .footer__links a {
    transition: color 0.18s var(--ease);
  }

  .footer__links a:hover {
    color: var(--text);
  }

  .footer__legal {
    flex-basis: 100%;
    padding-top: 20px;
    border-top: 1px solid var(--line);
    font-size: 0.75rem;
    color: var(--dim);
  }

  @media (max-width: 640px) {
    .footer__links {
      margin-left: 0;
      gap: 16px;
    }
  }
</style>
